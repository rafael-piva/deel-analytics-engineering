# Copy to .env, fill in, then: set -a; source .env; set +a
# Keep values plain (no inline comments, no $HOME or ~) so any .env loader reads them the same way.

# orgname-accountname, e.g. from https://app.snowflake.com/<orgname>/<accountname>/
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=DBT_USER
# Absolute path: dbt does not expand $HOME or ~
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.ssh/snowflake_dbt_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=DEEL_AE
SNOWFLAKE_SCHEMA=DBT_DEV
# Browser login instead of key-pair (needs an SSO identity provider on the account)
# DBT_TARGET=dev_sso

# Copy to .env, fill in, then: set -a; source .env; set +a
SNOWFLAKE_ACCOUNT=xy12345.eu-west-1        # or orgname-accountname
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PRIVATE_KEY_PATH=$HOME/.ssh/snowflake_dbt_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=DEEL_AE
SNOWFLAKE_SCHEMA=DBT_DEV
# DBT_TARGET=dev_sso                       # use browser login instead of key-pair
